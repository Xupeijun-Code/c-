// ==================== 主函数 ====================
int main() {
    // 初始化图形窗口
    initgraph(WIDTH, HEIGHT);
    SetWindowText(GetHWnd(), L"地狱挑战 - 五关生死劫");

    setbkcolor(BLACK);
    cleardevice();
    srand((unsigned)time(NULL));

    int totalScore = 0;
    bool gameComplete = false;

    // 尝试播放音乐（忽略错误）
    mciSendString(L"open \"level1.wav\" type mpegvideo alias bgm", NULL, 0, NULL);
    mciSendString(L"play bgm repeat", NULL, 0, NULL);

    // 五关循环
    for (int level = 1; level <= 5; level++) {
        // 显示关卡开始画面
        showLevelStart(level);

        // 获取当前关卡配置
        LevelConfig& cfg = levels[level - 1];

        // 初始化关卡
        Player player = initPlayer();
        std::list<Obstacle> obstacles;
        std::list<PowerUp> powerUps;

        int frameCount = 0;
        int timeLeft = 30;
        clock_t lastTime = clock();
        int spawnCounter = 0;

        // 初始生成障碍物（大幅提升开局密度）
        for (int i = 0; i < 20; i++) {
            obstacles.push_back(createObstacle(cfg.baseSpeed, cfg.obstacleSize));
        }

        // 关卡主循环
        while (player.health > 0 && timeLeft > 0) {
            // 新增：空格键暂停/恢复检测
            if (GetAsyncKeyState(VK_SPACE) & 0x8000) {
                // 防止重复触发，短暂延迟
                Sleep(200);
                isPaused = !isPaused;

                // 暂停时显示提示
                if (isPaused) {
                    cleardevice();
                    settextcolor(YELLOW);
                    settextstyle(64, 0, L"微软雅黑");
                    outtextxy((WIDTH - textwidth(L"游戏暂停")) / 2, HEIGHT / 2 - 50, L"游戏暂停");
                    settextcolor(WHITE);
                    settextstyle(24, 0, L"微软雅黑");
                    outtextxy((WIDTH - textwidth(L"再次按空格键恢复")) / 2, HEIGHT / 2 + 50, L"再次按空格键恢复");
                    FlushBatchDraw();
                }
            }

            // 新增：暂停状态下跳过所有逻辑更新
            if (isPaused) {
                Sleep(50); // 降低暂停时的CPU占用
                continue;
            }

            frameCount++;
            spawnCounter++;

            // 计时
            clock_t currentTime = clock();
            if (currentTime - lastTime >= CLOCKS_PER_SEC) {
                timeLeft--;
                lastTime = currentTime;
            }
            // ... 后续逻辑不变

            // 护盾计时
            if (player.hasShield) {
                player.shieldTimer--;
                if (player.shieldTimer <= 0) {
                    player.hasShield = false;
                }
            }

            // WASD控制
            player.isMovingUp = (GetAsyncKeyState('W') & 0x8000) != 0;
            player.isMovingDown = (GetAsyncKeyState('S') & 0x8000) != 0;
            player.isMovingLeft = (GetAsyncKeyState('A') & 0x8000) != 0;
            player.isMovingRight = (GetAsyncKeyState('D') & 0x8000) != 0;

            // 更新玩家位置
            if (player.isMovingLeft) {
                player.x -= MOVE_SPEED;
                if (player.x < 0) player.x = 0;
            }
            if (player.isMovingRight) {
                player.x += MOVE_SPEED;
                if (player.x > WIDTH - PLAYER_SIZE) player.x = WIDTH - PLAYER_SIZE;
            }
            if (player.isMovingUp) {
                player.y -= RISE_SPEED;
                if (player.y < 0) player.y = 0;
            }
            if (player.isMovingDown) {
                player.y += FALL_SPEED;
                if (player.y > HEIGHT - PLAYER_SIZE - 20)
                    player.y = HEIGHT - PLAYER_SIZE - 20;
            }

            // 自动下落
            if (!player.isMovingUp && !player.isMovingDown) {
                if (player.y < HEIGHT - PLAYER_SIZE - 20) {
                    player.y += FALL_SPEED / 2;
                }
            }

            // 生成新障碍物
            if (obstacles.size() < cfg.maxObstacles && spawnCounter >= cfg.spawnRate) {
                obstacles.push_back(createObstacle(cfg.baseSpeed, cfg.obstacleSize));
                spawnCounter = 0;
            }

            // 生成道具
            if (cfg.allowPowerUps && powerUps.size() < 2) {
                if (rand() % 100 < cfg.powerUpChance) {
                    PowerUpType type = (rand() % 2 == 0) ? POWERUP_SHIELD : POWERUP_HEALTH;
                    powerUps.push_back(createPowerUp(cfg.baseSpeed, type));
                }
            }

            // 更新障碍物
            for (auto it = obstacles.begin(); it != obstacles.end();) {
                if (!it->active) {
                    it = obstacles.erase(it);
                    continue;
                }

                it->y += it->speed;

                // 碰撞检测
                if (player.x < it->x + it->size &&
                    player.x + PLAYER_SIZE > it->x &&
                    player.y < it->y + it->size &&
                    player.y + PLAYER_SIZE > it->y) {

                    if (!player.hasShield) {
                        player.health -= 15;
                    }
                    it->active = false;
                    totalScore += 5;
                }

                if (it->y > HEIGHT) {
                    it->active = false;
                }

                ++it;
            }

            // 更新道具
            for (auto it = powerUps.begin(); it != powerUps.end();) {
                if (!it->active) {
                    it = powerUps.erase(it);
                    continue;
                }

                it->y += it->speed;

                if (player.x < it->x + POWERUP_SIZE &&
                    player.x + PLAYER_SIZE > it->x &&
                    player.y < it->y + POWERUP_SIZE &&
                    player.y + PLAYER_SIZE > it->y) {

                    if (it->type == POWERUP_SHIELD) {
                        player.hasShield = true;
                        player.shieldTimer = 180;  // 3秒
                    }
                    else {
                        player.health += 20;
                        if (player.health > 100) player.health = 100;
                    }

                    it->active = false;
                    totalScore += 10;
                }

                if (it->y > HEIGHT) {
                    it->active = false;
                }

                ++it;
            }

            // 绘制画面
            drawGame(player, obstacles, powerUps, totalScore,
                level, timeLeft, frameCount, cfg);

            // 延迟（60fps）
            Sleep(16);

            // 鼠标右键退出检测
            if (MouseHit()) {
                MOUSEMSG msg = GetMouseMsg();
                if (msg.uMsg == WM_RBUTTONDOWN) {
                    mciSendString(L"close all", NULL, 0, NULL);
                    closegraph();
                    return 0;
                }
            }
        }

        // 关卡结束判定
        if (player.health <= 0) {
            showGameOver(totalScore, level);
            gameComplete = true;
            break;
        }
        else if (timeLeft <= 0 && level < 5) {
            showLevelComplete(level, totalScore);
        }
    }

    // 通关结局
    if (!gameComplete) {
        showGameComplete(totalScore);
    }

    // 清理
    mciSendString(L"close all", NULL, 0, NULL);
    closegraph();
    return 0;
}