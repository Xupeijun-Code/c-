#include <graphics.h>
#include <conio.h>
#include <stdlib.h>
#include <time.h>
#include <string>
#include <list>
#include <mmsystem.h>
#pragma comment(lib, "winmm.lib")

// ==================== 常量定义 ====================
const int WIDTH = 1200;
const int HEIGHT = 800;
const int PLAYER_SIZE = 45;
const int POWERUP_SIZE = 30;

// 移动速度
const int MOVE_SPEED = 25;
const int RISE_SPEED = 15;
const int FALL_SPEED = 10;

// 道具类型
enum PowerUpType {
    POWERUP_NONE,
    POWERUP_SHIELD,
    POWERUP_HEALTH
};

// ==================== 结构体定义 ====================
struct Player {
    int x, y;
    int health;
    bool hasShield;
    int shieldTimer;
    bool isMovingUp;
    bool isMovingDown;
    bool isMovingLeft;
    bool isMovingRight;
};

struct Obstacle {
    int x, y;
    int speed;
    int size;
    bool active;
};

struct PowerUp {
    int x, y;
    int speed;
    PowerUpType type;
    bool active;
};

// 关卡配置结构
struct LevelConfig {
    int baseSpeed;
    int maxObstacles;
    int spawnRate;
    int obstacleSize;
    bool allowPowerUps;
    int powerUpChance;
};

// ==================== 五关地狱难度配置（核心修改：大幅提升baseSpeed） ====================
LevelConfig levels[5] = {
    {15,  30, 8, 35, false, 0},   // 第1关：maxObstacles 18→30，spawnRate 15→8
    {22, 45, 6, 32, false, 0},   // 第2关：maxObstacles 25→45，spawnRate 12→6
    {30, 60, 4, 30, true,  8},   // 第3关：maxObstacles 35→60，spawnRate 10→4
    {38, 75, 3, 28, true,  12},  // 第4关：maxObstacles 45→75，spawnRate 8→3
    {48, 90, 2,  25, true,  15}   // 第5关：maxObstacles 55→90，spawnRate 6→2
};

// 关卡描述
const wchar_t* levelDescriptions[5] = {
    L"第一关",
    L"第二关",
    L"第三关",
    L"第四关",
    L"第五关"
};
bool isPaused = false;

// ==================== 函数声明 ====================
Player initPlayer();
Obstacle createObstacle(int baseSpeed, int size);
PowerUp createPowerUp(int baseSpeed, PowerUpType type);
void drawGame(Player& p, std::list<Obstacle>& obstacles,
    std::list<PowerUp>& powerUps, int score, int level,
    int timeLeft, int frameCount, LevelConfig& cfg);
void showLevelStart(int level);
void showLevelComplete(int level, int score);
void showGameOver(int score, int level);
void showGameComplete(int score);

// ==================== 函数实现 ====================

// 初始化玩家
Player initPlayer() {
    Player p;
    p.x = WIDTH / 2 - PLAYER_SIZE / 2;
    p.y = HEIGHT - PLAYER_SIZE - 20;
    p.health = 100;
    p.hasShield = false;
    p.shieldTimer = 0;
    p.isMovingUp = false;
    p.isMovingDown = false;
    p.isMovingLeft = false;
    p.isMovingRight = false;
    return p;
}

// 生成障碍物（核心修改：提升随机速度波动范围，让障碍速度更不稳定）
Obstacle createObstacle(int baseSpeed, int size) {
    Obstacle o;
    o.x = rand() % (WIDTH - size);
    o.y = -size - rand() % 200;
    // 原：baseSpeed + (rand() %5 -2) → 改为 ±5，且最低速度提升
    o.speed = baseSpeed + (rand() % 11 - 5);  // 速度波动±5（原±2）
    if (o.speed < baseSpeed - 3) o.speed = baseSpeed - 3;  // 最低不低于基准-3（原3）
    o.size = size;
    o.active = true;
    return o;
}

// 生成道具（同步提升道具速度，避免道具太容易获取）
PowerUp createPowerUp(int baseSpeed, PowerUpType type) {
    PowerUp p;
    p.x = rand() % (WIDTH - POWERUP_SIZE);
    p.y = -POWERUP_SIZE - rand() % 300;
    p.speed = baseSpeed - 5;  // 原-2→-5（道具下落更快）
    if (p.speed < 5) p.speed = 5;  // 原2→5（最低速度提升）
    p.type = type;
    p.active = true;
    return p;
}

// 绘制游戏画面
void drawGame(Player& p, std::list<Obstacle>& obstacles,
    std::list<PowerUp>& powerUps, int score, int level,
    int timeLeft, int frameCount, LevelConfig& cfg) {
    BeginBatchDraw();
    cleardevice();

    // 绘制网格背景
    setlinecolor(RGB(30, 30, 30));
    for (int i = 0; i < WIDTH; i += 50) {
        line(i, 0, i, HEIGHT);
    }
    for (int i = 0; i < HEIGHT; i += 50) {
        line(0, i, WIDTH, i);
    }

    // 绘制障碍物
    for (auto& obs : obstacles) {
        if (!obs.active) continue;

        int red = 150 + (obs.speed * 5);
        if (red > 255) red = 255;
        setfillcolor(RGB(red, 30, 30));
        solidrectangle(obs.x, obs.y, obs.x + obs.size, obs.y + obs.size);

        setlinecolor(RGB(255, 100, 100));
        line(obs.x, obs.y, obs.x + obs.size, obs.y + obs.size);
        line(obs.x + obs.size, obs.y, obs.x, obs.y + obs.size);
    }

    // 绘制道具
    for (auto& pu : powerUps) {
        if (!pu.active) continue;

        if (pu.type == POWERUP_SHIELD) {
            setfillcolor(BLUE);
            solidcircle(pu.x + POWERUP_SIZE / 2, pu.y + POWERUP_SIZE / 2, POWERUP_SIZE / 2);
            setlinecolor(WHITE);
            circle(pu.x + POWERUP_SIZE / 2, pu.y + POWERUP_SIZE / 2, POWERUP_SIZE / 3);
        }
        else {
            setfillcolor(GREEN);
            solidcircle(pu.x + POWERUP_SIZE / 2, pu.y + POWERUP_SIZE / 2, POWERUP_SIZE / 2);
            setlinecolor(WHITE);
            line(pu.x + POWERUP_SIZE / 2 - 8, pu.y + POWERUP_SIZE / 2,
                pu.x + POWERUP_SIZE / 2 + 8, pu.y + POWERUP_SIZE / 2);
            line(pu.x + POWERUP_SIZE / 2, pu.y + POWERUP_SIZE / 2 - 8,
                pu.x + POWERUP_SIZE / 2, pu.y + POWERUP_SIZE / 2 + 8);
        }
    }

    // 绘制玩家
    if (p.hasShield) {
        setlinecolor(BLUE);
        for (int i = 0; i < 3; i++) {
            circle(p.x + PLAYER_SIZE / 2, p.y + PLAYER_SIZE / 2,
                PLAYER_SIZE / 2 + 5 + i * 3);
        }
    }

    int healthColor = RGB(255 - p.health, p.health, 0);
    setlinecolor(healthColor);
    circle(p.x + PLAYER_SIZE / 2, p.y + PLAYER_SIZE / 2, PLAYER_SIZE / 2 + 2);

    setfillcolor(WHITE);
    solidcircle(p.x + PLAYER_SIZE / 2, p.y + PLAYER_SIZE / 2, PLAYER_SIZE / 2);

    setfillcolor(BLACK);
    solidcircle(p.x + PLAYER_SIZE / 3, p.y + PLAYER_SIZE / 3, 4);
    solidcircle(p.x + 2 * PLAYER_SIZE / 3, p.y + PLAYER_SIZE / 3, 4);

    // 显示游戏信息（全中文）
    settextcolor(WHITE);
    setbkmode(TRANSPARENT);
    settextstyle(24, 0, L"微软雅黑");

    wchar_t infoStr[100];
    swprintf(infoStr, 100, L"第 %d 关 / 5  |  得分: %d  |  生命: %d%%  |  倒计时: %d秒",
        level, score, p.health, timeLeft);
    outtextxy(20, 20, infoStr);

    settextcolor(RGB(255, 200, 100));
    outtextxy(20, 60, levelDescriptions[level - 1]);

    settextcolor(WHITE);
    wchar_t obsStr[100];
    swprintf(obsStr, 100, L"当前障碍: %d / %d  |  速度: %d",
        (int)obstacles.size(), cfg.maxObstacles, cfg.baseSpeed);
    outtextxy(20, 90, obsStr);

    // 生命条
    setlinecolor(WHITE);
    rectangle(20, 120, 320, 140);
    if (p.health > 60) setfillcolor(GREEN);
    else if (p.health > 30) setfillcolor(YELLOW);
    else setfillcolor(RED);
    solidrectangle(21, 121, 21 + (p.health * 3), 139);

    if (p.hasShield) {
        settextcolor(BLUE);
        wchar_t shieldStr[50];
        swprintf(shieldStr, 50, L"护盾: %d秒", p.shieldTimer / 60);
        outtextxy(340, 120, shieldStr);
    }

    // 右侧操作提示
    settextcolor(RGB(200, 200, 200));
    settextstyle(24, 0, L"微软雅黑");
    outtextxy(WIDTH - 280, 20, L"操作说明");

    settextstyle(20, 0, L"微软雅黑");
    outtextxy(WIDTH - 280, 60, L"W  ↑");
    outtextxy(WIDTH - 280, 90, L"S  ↓");
    outtextxy(WIDTH - 280, 120, L"A  ←");
    outtextxy(WIDTH - 280, 150, L"D  →");

    if (level >= 3) {
        settextcolor(RGB(100, 200, 255));
        outtextxy(WIDTH - 280, 200, L"蓝色：护盾");
        settextcolor(RGB(100, 255, 100));
        outtextxy(WIDTH - 280, 230, L"绿色：血包");
    }

    // 底部提示
    settextcolor(RGB(150, 150, 150));
    settextstyle(18, 0, L"微软雅黑");
    outtextxy(20, HEIGHT - 30, L"红色障碍碰触扣15生命 | 鼠标右键退出游戏");

    EndBatchDraw();
}

// 显示关卡开始画面 - 终极版（鼠标点击开始）
void showLevelStart(int level) {
    cleardevice();
    setbkcolor(BLACK);
    cleardevice();

    settextcolor(RGB(255, 215, 0));
    settextstyle(56, 0, L"微软雅黑");
    wchar_t levelStr[50];
    swprintf(levelStr, 50, L"第 %d 关", level);

    int textWidth = textwidth(levelStr);
    outtextxy((WIDTH - textWidth) / 2, HEIGHT / 2 - 100, levelStr);

    settextstyle(36, 0, L"微软雅黑");
    settextcolor(RGB(200, 200, 255));

    textWidth = textwidth(levelDescriptions[level - 1]);
    outtextxy((WIDTH - textWidth) / 2, HEIGHT / 2, levelDescriptions[level - 1]);

    settextstyle(28, 0, L"微软雅黑");
    settextcolor(WHITE);

    LevelConfig& cfg = levels[level - 1];
    wchar_t detailStr[200];
    swprintf(detailStr, 200, L"速度: %d  最大数量: %d  障碍大小: %dpx",
        cfg.baseSpeed, cfg.maxObstacles, cfg.obstacleSize);

    textWidth = textwidth(detailStr);
    outtextxy((WIDTH - textWidth) / 2, HEIGHT / 2 + 60, detailStr);

    if (cfg.allowPowerUps) {
        settextcolor(GREEN);
        wchar_t powerUpStr[] = L"本关出现道具！";
        textWidth = textwidth(powerUpStr);
        outtextxy((WIDTH - textWidth) / 2, HEIGHT / 2 + 100, powerUpStr);
    }

    settextcolor(RGB(150, 150, 150));
    wchar_t tipStr[] = L"点击鼠标左键开始 | 右键退出";
    textWidth = textwidth(tipStr);
    outtextxy((WIDTH - textWidth) / 2, HEIGHT / 2 + 160, tipStr);

    FlushBatchDraw();

    // 等待鼠标点击
    MOUSEMSG msg;
    while (true) {
        msg = GetMouseMsg();
        if (msg.uMsg == WM_LBUTTONDOWN) {
            break;
        }
        if (msg.uMsg == WM_RBUTTONDOWN) {  // 右键退出
            closegraph();
            exit(0);
        }
    }
}

