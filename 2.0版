    cleardevice();

    settextcolor(GREEN);
    settextstyle(56, 0, L"微软雅黑");
    outtextxy((WIDTH - textwidth(L"关卡通过！")) / 2, HEIGHT / 2 - 100, L"关卡通过！");

    settextstyle(32, 0, L"微软雅黑");
    settextcolor(YELLOW);
    wchar_t scoreStr[100];
    swprintf(scoreStr, 100, L"当前得分: %d", score);
    outtextxy((WIDTH - textwidth(scoreStr)) / 2, HEIGHT / 2, scoreStr);

    if (level < 5) {
        settextstyle(28, 0, L"微软雅黑");
        settextcolor(WHITE);
        wchar_t nextStr[100];
        swprintf(nextStr, 100, L"即将进入第 %d 关...", level + 1);
        outtextxy((WIDTH - textwidth(nextStr)) / 2, HEIGHT / 2 + 60, nextStr);
    }

    settextcolor(RGB(150, 150, 150));
    wchar_t tipStr[] = L"点击鼠标左键继续";
    outtextxy((WIDTH - textwidth(tipStr)) / 2, HEIGHT / 2 + 120, tipStr);

    FlushBatchDraw();

    // 等待鼠标点击
    MOUSEMSG msg;
    while (true) {
        msg = GetMouseMsg();
        if (msg.uMsg == WM_LBUTTONDOWN) {
            break;
        }
    }
}

