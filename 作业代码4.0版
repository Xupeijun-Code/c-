// ==================== SDL3音频函数实现（核心修复：适配SDL3_mixer函数命名） ====================
bool initSDL3Audio() {
    // SDL3 初始化音频子系统（替代SDL2的SDL_Init(SDL_INIT_AUDIO)）
    if (SDL_InitSubSystem(SDL_INIT_AUDIO) != 0) {
        printf("SDL3音频子系统初始化失败: %s\n", SDL_GetError());
        return false;
    }

    // SDL3_mixer 初始化（兼容新旧接口）
#ifdef Mix_Init
    if (Mix_Init(MIX_INIT_MP3) == 0) { // 仅初始化MP3支持（如需OGG加MIX_INIT_OGG）
        printf("Mix_Init失败: %s\n", Mix_GetError());
        SDL_QuitSubSystem(SDL_INIT_AUDIO);
        return false;
    }
#elif defined(SDL_Mix_Init)
    if (SDL_Mix_Init(MIX_INIT_MP3) == 0) {
        printf("SDL_Mix_Init失败: %s\n", SDL_Mix_GetError());
        SDL_QuitSubSystem(SDL_INIT_AUDIO);
        return false;
    }
#endif

    // SDL3 打开音频设备（兼容新旧接口）
#ifdef Mix_OpenAudioDevice
    if (Mix_OpenAudioDevice(44100, MIX_DEFAULT_FORMAT, 2, 4096, nullptr, SDL_AUDIO_ALLOW_ANY_CHANGE) == -1) {
        printf("打开音频设备失败: %s\n", Mix_GetError());
#ifdef Mix_Quit
        Mix_Quit();
#else
        SDL_Mix_Quit();
#endif
        SDL_QuitSubSystem(SDL_INIT_AUDIO);
        return false;
    }
#elif defined(SDL_Mix_OpenAudioDevice)
    if (SDL_Mix_OpenAudioDevice(44100, SDL_MIX_DEFAULT_FORMAT, 2, 4096, nullptr, SDL_AUDIO_ALLOW_ANY_CHANGE) == -1) {
        printf("打开音频设备失败: %s\n", SDL_Mix_GetError());
        SDL_Mix_Quit();
        SDL_QuitSubSystem(SDL_INIT_AUDIO);
        return false;
    }
#endif

    // SDL3 预分配音频声道（兼容新旧接口）
#ifdef Mix_AllocateChannels
    Mix_AllocateChannels(16); // 分配16个声道足够使用
#elif defined(SDL_Mix_AllocateChannels)
    SDL_Mix_AllocateChannels(16);
#endif

    // 设置音量（兼容新旧接口）
#ifdef Mix_VolumeMusic
    Mix_VolumeMusic(80);  // 背景音乐音量
    Mix_Volume(-1, 100);  // 所有音效音量
#elif defined(SDL_Mix_VolumeMusic)
    SDL_Mix_VolumeMusic(80);
    SDL_Mix_Volume(-1, 100);
#endif
    return true;
}

