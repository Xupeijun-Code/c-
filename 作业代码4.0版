Player initPlayer() {
    Player p;
    p.x = WIDTH / 2 - PLAYER_SIZE / 2;
    p.y = HEIGHT - PLAYER_SIZE - 20;
    p.health = 100;
    p.hasShield = false;
    p.shieldTimer = 0;
    p.isMovingUp = false;
    p.isMovingDown = false;
    p.isMovingLeft = false;
    p.isMovingRight = false;
    p.isTimeSlowed = false;
    p.timeSlowStart = 0;
    p.shockwaveCount = 0;
    p.isColorful = false;
    p.colorStart = 0;
    return p;
}

Obstacle createObstacle(int baseSpeed, int size) {
    Obstacle o;
    o.x = rand() % (WIDTH - size);
    o.y = -size - rand() % 200;
    o.speed = baseSpeed + rand() % 3;
    o.originalSpeed = o.speed;
    o.size = size;
    o.active = true;
    return o;
}

PowerUp createPowerUp(int baseSpeed, PowerUpType type, int playerHealth) {
    PowerUp p;
    int puSize = (type == POWERUP_TOTEM ? TOTEM_SIZE : POWERUP_SIZE);
    int x = rand() % (WIDTH - puSize);
    p.x = x;
    p.y = -puSize - rand() % 200;
    int speedOffset = (type == POWERUP_TOTEM ? 12 : 8);
    p.speed = baseSpeed - speedOffset;
    if (p.speed < 2) p.speed = 2;
    p.type = type;
    p.active = true;
    if (type == POWERUP_TOTEM) {
        isTotemActive = true;
    }
    return p;
}

void drawShockwaveEffect() {
    for (auto& sw : shockwaves) {
        if (!sw.active) continue;
        int r = 255, g = 200, b = 0;
        int alpha = sw.alpha;
        COLORREF waveColor = RGB(r * alpha / 255, g * alpha / 255, b * alpha / 255);
        setlinecolor(waveColor);
        for (int i = 0; i < 3; i++) {
            circle(sw.x, sw.y, sw.radius - i * 5);
        }
    }
}

void updateShockwaveEffect() {
    for (auto it = shockwaves.begin(); it != shockwaves.end();) {
        if (!it->active) {
            it = shockwaves.erase(it);
            continue;
        }
        it->radius += 8;
        it->alpha -= 8;
        if (it->radius > it->maxRadius || it->alpha <= 0) {
            it->active = false;
        }
        ++it;
    }
}

void triggerShockwave(Player& p, std::list<Obstacle>& obstacles) {
    int playerCenterX = p.x + PLAYER_SIZE / 2;
    int playerCenterY = p.y + PLAYER_SIZE / 2;

    Shockwave sw;
    sw.x = playerCenterX;
    sw.y = playerCenterY;
    sw.radius = 30;
    sw.maxRadius = SHOCKWAVE_RADIUS;
    sw.alpha = 255;
    sw.active = true;
    shockwaves.push_back(sw);

    for (auto it = obstacles.begin(); it != obstacles.end();) {
        if (!it->active) {
            it = obstacles.erase(it);
            continue;
        }

        int obsCenterX = it->x + it->size / 2;
        int obsCenterY = it->y + it->size / 2;
        int dx = abs(obsCenterX - playerCenterX);
        int dy = abs(obsCenterY - playerCenterY);

        if (dx + dy < SHOCKWAVE_RADIUS) {
            it->active = false;
        }
        ++it;
    }
}

void applyTimeSlow(std::list<Obstacle>& obstacles, bool enable) {
    for (auto& obs : obstacles) {
        if (enable) {
            obs.speed = (int)(obs.originalSpeed * TIME_SLOW_FACTOR);
        }
        else {
            obs.speed = obs.originalSpeed;
        }
    }
}

void drawGame(Player& p, std::list<Obstacle>& obstacles,
    std::list<PowerUp>& powerUps, int level,
    int timeLeft, int frameCount, LevelConfig& cfg) {
    cleardevice();

    setlinecolor(RGB(30, 30, 30));
    for (int i = 0; i < WIDTH; i += 50) {
        line(i, 0, i, HEIGHT);
    }
    for (int i = 0; i < HEIGHT; i += 50) {
        line(0, i, WIDTH, i);
    }

    for (auto& obs : obstacles) {
        if (!obs.active) continue;

        int red = 150 + (obs.speed * 5);
        if (red > 255) red = 255;

        if (p.isTimeSlowed) {
            setfillcolor(RGB(red / 1.5, 80 / 1.5, 80 / 1.5));
        }
        else {
            setfillcolor(RGB(red, 80, 80));
        }
        solidrectangle(obs.x, obs.y, obs.x + obs.size, obs.y + obs.size);

        setlinecolor(RGB(255, 100, 100));
        line(obs.x, obs.y, obs.x + obs.size, obs.y + obs.size);
        line(obs.x + obs.size, obs.y, obs.x, obs.y + obs.size);
    }

    for (auto& pu : powerUps) {
        if (!pu.active) continue;

        if (pu.type == POWERUP_SHIELD) {
            setfillcolor(BLUE);
            solidcircle(pu.x + POWERUP_SIZE / 2, pu.y + POWERUP_SIZE / 2, POWERUP_SIZE / 2);
            setlinecolor(WHITE);
            circle(pu.x + POWERUP_SIZE / 2, pu.y + POWERUP_SIZE / 2, POWERUP_SIZE / 3);
        }
        else if (pu.type == POWERUP_HEALTH) {
            setfillcolor(GREEN);
            solidcircle(pu.x + POWERUP_SIZE / 2, pu.y + POWERUP_SIZE / 2, POWERUP_SIZE / 2);
            setlinecolor(WHITE);
            line(pu.x + POWERUP_SIZE / 2 - 8, pu.y + POWERUP_SIZE / 2,
                pu.x + POWERUP_SIZE / 2 + 8, pu.y + POWERUP_SIZE / 2);
            line(pu.x + POWERUP_SIZE / 2, pu.y + POWERUP_SIZE / 2 - 8,
                pu.x + POWERUP_SIZE / 2, pu.y + POWERUP_SIZE / 2 + 8);
        }
        else if (pu.type == POWERUP_TOTEM) {
            setfillcolor(RGB(255, 200, 0));
            solidcircle(pu.x + TOTEM_SIZE / 2, pu.y + TOTEM_SIZE / 2, TOTEM_SIZE / 2);
            setlinecolor(RGB(255, 150, 0));
            circle(pu.x + TOTEM_SIZE / 2, pu.y + TOTEM_SIZE / 2, TOTEM_SIZE / 2 - 3);
            line(pu.x + TOTEM_SIZE / 2 - 6, pu.y + TOTEM_SIZE / 2,
                pu.x + TOTEM_SIZE / 2 + 6, pu.y + TOTEM_SIZE / 2);
            line(pu.x + TOTEM_SIZE / 2, pu.y + TOTEM_SIZE / 2 - 6,
                pu.x + TOTEM_SIZE / 2, pu.y + TOTEM_SIZE / 2 + 6);
        }
    }

    if (p.hasShield) {
        setlinecolor(BLUE);
        for (int i = 0; i < 3; i++) {
            circle(p.x + PLAYER_SIZE / 2, p.y + PLAYER_SIZE / 2,
                PLAYER_SIZE / 2 + 5 + i * 3);
        }
    }

    if (p.isTimeSlowed) {
        setlinecolor(RGB(255, 200, 0));
        circle(p.x + PLAYER_SIZE / 2, p.y + PLAYER_SIZE / 2, PLAYER_SIZE / 2 + 8);
        settextstyle(20, 0, L"微软雅黑");
        outtextxy(p.x + PLAYER_SIZE / 2 - 15, p.y + PLAYER_SIZE / 2 - 10, L"减速");
    }

    if (p.isColorful) {
        DWORD currentTime = GetTickCount();
        int colorStep = (currentTime - p.colorStart) / 100 % 6;
        COLORREF playerColor;
        switch (colorStep) {
        case 0: playerColor = RED; break;
        case 1: playerColor = YELLOW; break;
        case 2: playerColor = GREEN; break;
        case 3: playerColor = CYAN; break;
        case 4: playerColor = BLUE; break;
        case 5: playerColor = MAGENTA; break;
        default: playerColor = WHITE;
        }
        setlinecolor(playerColor);
    }
    else {
        int healthColor = RGB(255 - p.health * 2.55, p.health * 2.55, 0);
        setlinecolor(healthColor);
    }

    circle(p.x + PLAYER_SIZE / 2, p.y + PLAYER_SIZE / 2, PLAYER_SIZE / 2 + 2);

    if (p.isColorful) {
        setfillcolor(RGB(255, 255, 255));
    }
    else {
        setfillcolor(WHITE);
    }
    solidcircle(p.x + PLAYER_SIZE / 2, p.y + PLAYER_SIZE / 2, PLAYER_SIZE / 2);

    setfillcolor(BLACK);
    solidcircle(p.x + PLAYER_SIZE / 3, p.y + PLAYER_SIZE / 3, 4);
    solidcircle(p.x + 2 * PLAYER_SIZE / 3, p.y + PLAYER_SIZE / 3, 4);

    drawShockwaveEffect();
    updateShockwaveEffect();

    settextcolor(WHITE);
    setbkmode(TRANSPARENT);
    settextstyle(24, 0, L"微软雅黑");

    wchar_t infoStr[200];
    swprintf(infoStr, 200, L"第 %d 关 | 剩余血量: %d%% | 倒计时: %d秒",
        level, p.health, timeLeft);
    outtextxy(20, 20, infoStr);

    settextcolor(RGB(255, 200, 100));
    outtextxy(20, 50, levelDescriptions[level - 1]);

    setlinecolor(WHITE);
    rectangle(20, 80, 320, 100);
    if (p.health > 60) setfillcolor(GREEN);
    else if (p.health > 30) setfillcolor(YELLOW);
    else setfillcolor(RED);
    solidrectangle(21, 81, 21 + (p.health * 3), 99);

    if (p.hasShield) {
        settextcolor(BLUE);
        wchar_t shieldStr[50];
        swprintf(shieldStr, 50, L"护盾剩余: %d秒", p.shieldTimer / 60);
        outtextxy(340, 80, shieldStr);
    }

    if (p.isTimeSlowed) {
        settextcolor(RGB(255, 200, 0));
        wchar_t slowStr[50];
        swprintf(slowStr, 50, L"减速剩余: %d秒", (TIME_SLOW_DURATION - (GetTickCount() - p.timeSlowStart)) / 1000);
        outtextxy(340, 110, slowStr);
    }

    settextcolor(RGB(200, 200, 200));
    settextstyle(24, 0, L"微软雅黑");
    outtextxy(WIDTH - 280, 20, L"操作说明");

    settextstyle(20, 0, L"微软雅黑");
    outtextxy(WIDTH - 280, 60, L"W  ↑");
    outtextxy(WIDTH - 280, 90, L"S  ↓");
    outtextxy(WIDTH - 280, 120, L"A  ←");
    outtextxy(WIDTH - 280, 150, L"D  →");

    if (level >= 3) {
        settextcolor(RGB(100, 200, 255));
        outtextxy(WIDTH - 280, 200, L"蓝色：护盾");
        settextcolor(RGB(100, 255, 100));
        outtextxy(WIDTH - 280, 230, L"绿色：血包");
    }

    if (level == 5) {
        settextcolor(RGB(255, 200, 0));
        outtextxy(WIDTH - 280, 260, L"黄色：不死图腾");
        settextcolor(RGB(200, 200, 200));
        settextstyle(16, 0, L"微软雅黑");
        outtextxy(WIDTH - 280, 290, L"→ 血量<70%时出现 | 场景仅1个");
        outtextxy(WIDTH - 280, 310, L"→ 回血50% + 减速5秒 + 大范围冲击波");
    }

    settextcolor(RGB(150, 150, 150));
    settextstyle(18, 0, L"微软雅黑");
    outtextxy(20, HEIGHT - 30, L"空格键暂停 | 鼠标右键退出游戏");

    FlushBatchDraw();
}

void drawButton(Button& btn) {
    if (btn.hover) {
        setfillcolor(RGB(80, 80, 80));
        setlinecolor(RGB(255, 200, 0));
    }
    else {
        setfillcolor(RGB(50, 50, 50));
        setlinecolor(RGB(200, 200, 200));
    }
    solidroundrect(btn.x, btn.y, btn.x + btn.w, btn.y + btn.h, 10, 10);
    settextcolor(WHITE);
    setbkmode(TRANSPARENT);
    settextstyle(28, 0, L"微软雅黑");
    int textW = textwidth(btn.text);
    int textH = textheight(btn.text);
    outtextxy(btn.x + (btn.w - textW) / 2, btn.y + (btn.h - textH) / 2, btn.text);
}

bool checkButtonClick(Button& btn, MOUSEMSG& msg) {
    bool clicked = false;
    if (msg.x >= btn.x && msg.x <= btn.x + btn.w &&
        msg.y >= btn.y && msg.y <= btn.y + btn.h &&
        msg.uMsg == WM_LBUTTONDOWN) {
        clicked = true;
        playClickSound(); // 点击按钮播放音效
    }
    btn.hover = (msg.x >= btn.x && msg.x <= btn.x + btn.w &&
        msg.y >= btn.y && msg.y <= btn.y + btn.h);
    return clicked;
}

