// ==================== 主函数（SDL3适配） ====================
int main(int argc, char* argv[]) { // SDL3无需SDL2main.lib，主函数带参数即可
    // 初始化SDL3音频
    if (!initSDL3Audio()) {
        printf("音频初始化失败！\n");
        return -1;
    }
    // 加载音频资源
    loadAudioResources();

    initgraph(WIDTH, HEIGHT);
    SetWindowText(GetHWnd(), L"地狱挑战 - 五关生死劫（高帧率版）");

    setbkcolor(BLACK);
    cleardevice();
    srand((unsigned)time(NULL));

    // 播放菜单背景音乐
    playMenuBgMusic();

    while (true) {
        switch (currentMenu) {
        case MENU_MAIN:
            drawMainMenu();
            break;

        case MENU_LEVEL_SELECT:
            drawLevelSelectMenu();
            break;

        case MENU_GAME: {
            showLevelStart(currentLevel);
            LevelConfig& cfg = levels[currentLevel - 1];
            Player player = initPlayer();
            std::list<Obstacle> obstacles;
            std::list<PowerUp> powerUps;

            int frameCount = 0;
            int timeLeft = 30;
            clock_t lastTime = clock();
            int spawnCounter = 0;
            isTotemActive = false;

            bool levelComplete = false;
            bool gameOver = false;
            while (!levelComplete && !gameOver) {
                if (GetAsyncKeyState(VK_SPACE) & 0x8000) {
                    Sleep(200);
                    isPaused = !isPaused;
                    if (isPaused) {
                        stopAllBgMusic(); // 暂停时停止音乐
                    }
                    else {
                        playLevelBgMusic(currentLevel); // 恢复时播放关卡音乐
                    }
                }

                if (isPaused) {
                    drawPauseMenu();
                    continue;
                }

                if (player.isTimeSlowed) {
                    DWORD elapsed = GetTickCount() - player.timeSlowStart;

                    if (player.shockwaveCount == 0 && elapsed >= 0) {
                        triggerShockwave(player, obstacles);
                        player.shockwaveCount = 1;
                    }
                    else if (player.shockwaveCount == 1 && elapsed >= SHOCKWAVE_INTERVAL) {
                        triggerShockwave(player, obstacles);
                        player.shockwaveCount = 2;
                    }
                    else if (player.shockwaveCount == 2 && elapsed >= 2 * SHOCKWAVE_INTERVAL) {
                        triggerShockwave(player, obstacles);
                        player.shockwaveCount = 3;
                    }

                    if (elapsed >= TIME_SLOW_DURATION) {
                        player.isTimeSlowed = false;
                        applyTimeSlow(obstacles, false);
                    }

                    player.isMovingUp = (GetAsyncKeyState('W') & 0x8000) != 0;
                    player.isMovingDown = (GetAsyncKeyState('S') & 0x8000) != 0;
                    player.isMovingLeft = (GetAsyncKeyState('A') & 0x8000) != 0;
                    player.isMovingRight = (GetAsyncKeyState('D') & 0x8000) != 0;

                    if (player.isMovingLeft) {
                        player.x -= MOVE_SPEED;
                        if (player.x < 0) player.x = 0;
                    }
                    if (player.isMovingRight) {
                        player.x += MOVE_SPEED;
                        if (player.x > WIDTH - PLAYER_SIZE) player.x = WIDTH - PLAYER_SIZE;
                    }
                    if (player.isMovingUp) {
                        player.y -= RISE_SPEED;
                        if (player.y < 0) player.y = 0;
                    }
                    if (player.isMovingDown) {
                        player.y += FALL_SPEED;
                        if (player.y > HEIGHT - PLAYER_SIZE - 20)
                            player.y = HEIGHT - PLAYER_SIZE - 20;
                    }

                    if (player.isColorful) {
                        DWORD colorElapsed = GetTickCount() - player.colorStart;
                        if (colorElapsed >= PLAYER_COLOR_DURATION) {
                            player.isColorful = false;
                        }
                    }

                    drawGame(player, obstacles, powerUps, currentLevel,
                        timeLeft, frameCount, cfg);
                    Sleep(8);
                    continue;
                }

                frameCount++;
                spawnCounter++;

                clock_t currentTime = clock();
                if (currentTime - lastTime >= CLOCKS_PER_SEC) {
                    timeLeft--;
                    lastTime = currentTime;
                }

                if (player.hasShield) {
                    player.shieldTimer--;
                    if (player.shieldTimer <= 0) {
                        player.hasShield = false;
                    }
                }

                if (player.isColorful) {
                    DWORD colorElapsed = GetTickCount() - player.colorStart;
                    if (colorElapsed >= PLAYER_COLOR_DURATION) {
                        player.isColorful = false;
                    }
                }

                player.isMovingUp = (GetAsyncKeyState('W') & 0x8000) != 0;
                player.isMovingDown = (GetAsyncKeyState('S') & 0x8000) != 0;
                player.isMovingLeft = (GetAsyncKeyState('A') & 0x8000) != 0;
                player.isMovingRight = (GetAsyncKeyState('D') & 0x8000) != 0;

                if (player.isMovingLeft) {
                    player.x -= MOVE_SPEED;
                    if (player.x < 0) player.x = 0;
                }
                if (player.isMovingRight) {
                    player.x += MOVE_SPEED;
                    if (player.x > WIDTH - PLAYER_SIZE) player.x = WIDTH - PLAYER_SIZE;
                }
                if (player.isMovingUp) {
                    player.y -= RISE_SPEED;
                    if (player.y < 0) player.y = 0;
                }
                if (player.isMovingDown) {
                    player.y += FALL_SPEED;
                    if (player.y > HEIGHT - PLAYER_SIZE - 20)
                        player.y = HEIGHT - PLAYER_SIZE - 20;
                }

                if (!player.isMovingUp && !player.isMovingDown) {
                    if (player.y < HEIGHT - PLAYER_SIZE - 20) {
                        player.y += FALL_SPEED / 2;
                    }
                }

                if (obstacles.size() < cfg.maxObstacles && spawnCounter >= cfg.spawnRate) {
                    obstacles.push_back(createObstacle(cfg.baseSpeed, cfg.obstacleSize));
                    spawnCounter = 0;
                }

                if (cfg.allowPowerUps && powerUps.size() < (currentLevel == 5 ? 2 : 3)) {
                    if (rand() % 100 < cfg.powerUpChance) {
                        PowerUpType type = (rand() % 2 == 0) ? POWERUP_SHIELD : POWERUP_HEALTH;
                        powerUps.push_back(createPowerUp(cfg.baseSpeed, type, player.health));
                    }
                    if (currentLevel == 5) {
                        if (player.health < TOTEM_SPAWN_HEALTH_THRESHOLD && !isTotemActive && rand() % 100 < cfg.totemChance) {
                            powerUps.push_back(createPowerUp(cfg.baseSpeed, POWERUP_TOTEM, player.health));
                        }
                    }
                }

                for (auto it = obstacles.begin(); it != obstacles.end();) {
                    if (!it->active) {
                        it = obstacles.erase(it);
                        continue;
                    }

                    it->y += it->speed;

                    if (player.x < it->x + it->size &&
                        player.x + PLAYER_SIZE > it->x &&
                        player.y < it->y + it->size &&
                        player.y + PLAYER_SIZE > it->y) {

                        if (!player.hasShield) {
                            player.health -= 10;
                            if (player.health < 0) player.health = 0;
                            playPlayerHurtSound(); // 播放受击音效
                        }
                        else {
                            player.hasShield = false;
                        }
                        it->active = false;
                    }

                    if (it->y > HEIGHT) {
                        it->active = false;
                    }

                    ++it;
                }

                for (auto it = powerUps.begin(); it != powerUps.end();) {
                    if (!it->active) {
                        if (it->type == POWERUP_TOTEM) {
                            isTotemActive = false;
                        }
                        it = powerUps.erase(it);
                        continue;
                    }

                    it->y += it->speed;

                    int puSize = (it->type == POWERUP_TOTEM ? TOTEM_SIZE : POWERUP_SIZE);
                    if (player.x < it->x + puSize &&
                        player.x + PLAYER_SIZE > it->x &&
                        player.y < it->y + puSize &&
                        player.y + PLAYER_SIZE > it->y) {

                        if (it->type == POWERUP_SHIELD) {
                            player.hasShield = true;
                            player.shieldTimer = 60;
                            playPickShieldSound(); // 播放拾取护盾音效
                        }
                        else if (it->type == POWERUP_HEALTH) {
                            player.health += 20;
                            if (player.health > 100) player.health = 100;
                            playPickHealthSound(); // 播放拾取血包音效
                        }
                        else if (it->type == POWERUP_TOTEM) {
                            player.health += 50;
                            if (player.health > 100) player.health = 100;
                            player.isTimeSlowed = true;
                            player.timeSlowStart = GetTickCount();
                            player.shockwaveCount = 0;
                            player.isColorful = true;
                            player.colorStart = GetTickCount();
                            applyTimeSlow(obstacles, true);
                            isTotemActive = false;
                            playPickTotemSound(); // 播放拾取图腾音效
                        }
                        it->active = false;
                    }

                    if (it->y > HEIGHT) {
                        if (it->type == POWERUP_TOTEM) {
                            isTotemActive = false;
                        }
                        it->active = false;
                    }

                    ++it;
                }

                drawGame(player, obstacles, powerUps, currentLevel,
                    timeLeft, frameCount, cfg);

                Sleep(8);

                if (MouseHit()) {
                    MOUSEMSG msg = GetMouseMsg();
                    if (msg.uMsg == WM_RBUTTONDOWN) {
                        cleanSDL3Audio(); // 退出前清理音频
                        closegraph();
                        return 0;
                    }
                }

                if (player.health <= 0) {
                    gameOver = true;
                    currentMenu = MENU_GAME_OVER;
                    playPlayerDeathMusic(); // 播放死亡音乐
                }
                else if (timeLeft <= 0) {
                    levelComplete = true;
                    if (currentLevel == 5) {
                        currentMenu = MENU_GAME_COMPLETE;
                        playGameWinMusic(); // 播放第五关胜利音乐
                    }
                    else {
                        currentMenu = MENU_LEVEL_COMPLETE;
                        playLevelWinMusic(); // 播放1-4关胜利音乐
                    }
                }
            }

            if (gameOver) {
                drawGameOverMenu(currentLevel);
            }
            else if (levelComplete && currentLevel == 5) {
                drawGameCompleteMenu();
            }
            else if (levelComplete) {
                drawLevelCompleteMenu(currentLevel);
            }

            break;
        }

        case MENU_PAUSE:
            drawPauseMenu();
            break;

        case MENU_LEVEL_COMPLETE:
            drawLevelCompleteMenu(currentLevel);
            break;

        case MENU_GAME_OVER:
            drawGameOverMenu(currentLevel);
            break;

        case MENU_GAME_COMPLETE:
            drawGameCompleteMenu();
            break;
        }
    }

    cleanSDL3Audio(); // 程序结束清理音频
    closegraph();
    return 0;
}
